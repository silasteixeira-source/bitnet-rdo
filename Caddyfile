# Configuração do Proxy Reverso (Caddy)

# Rota para o n8n com HTTPS automático via Cloudflare
{$DOMAIN_N8N} {
    reverse_proxy n8n:5678
}

# Rota para o Painel do NOC (Dashboard) via IP (HTTP padrão na porta 80)
# Se futuramente tiver um domínio, basta mudar :80 para o domínio, ex: painel.rinnecloud.shop
:80 {
    reverse_proxy noc-dashboard:8080
}
